# Session secret for Express (generate a random string)
SESSION_SECRET=your_session_secret_here

# Google Maps Platform API Key (enable Places API New, Geocoding API, Directions API)
# Get your key at: https://console.cloud.google.com/apis/credentials
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here

# Goong Maps API Key (fallback khi Google API không khả dụng)
# Get your key at: https://account.goong.io
GOONG_API_KEY=your_goong_api_key_here

# Gemini AI API Key (get from https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API Key (fallback khi Gemini fail)
OPENAI_API_KEY=sk-proj-your_openai_key_here

# PostgreSQL database connection string
# Local: postgresql://postgres:password@localhost:5432/plango
# Xata: postgresql://xata:KEY@workspace.region.xata.tech/db?sslmode=require
# Supabase: postgresql://postgres.xxx:PWD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://username:password@localhost:5432/plango

# Port for backend (default 5001 to avoid macOS AirPlay conflict on 5000)
PORT=5001

# Domain for Expo app to connect to backend server
# Local dev: use your LAN IP (run "ipconfig" to find IPv4) e.g. 192.168.1.100:5001
# Render deploy: set to plango-be.onrender.com (no protocol prefix)
# Railway deploy: set to your-app.up.railway.app
EXPO_PUBLIC_DOMAIN=192.168.0.198:5001

# SerpAPI Key (for Google Maps Reviews)
# Get your key at: https://serpapi.com
SERPAPI_KEY=your_serpapi_key_here

